<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64;AnyCPU</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <IsPackable>true</IsPackable>
    <PackageId>Lumina.Forms</PackageId>
    <Version>0.1.0</Version>
    <Authors>Lumina Contributors</Authors>
    <Description>LuminaForms WinForms-compatible layer for net10.0 and Native AOT desktop applications.</Description>
    <PackageTags>win32;native;forms;aot;mica;acrylic;windows;visual-effects</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PackageIcon>nuget-icon.png</PackageIcon>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackLuminaFormsAnalyzer</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lumina.Core\Lumina.Core.csproj" />
    <!-- The analyzer runs in the build host and must not inherit application publish settings. -->
    <ProjectReference Include="..\Lumina.Forms.Analyzers\Lumina.Forms.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;PublishReadyToRun;PublishSingleFile;SelfContained;RuntimeIdentifier;RuntimeIdentifiers;PublishDir" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="/" />
    <None Include="..\THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="..\assets\nuget-icon.png" Pack="true" PackagePath="/" />
    <None Include="buildTransitive\Lumina.Forms.props" Pack="true" PackagePath="buildTransitive\Lumina.Forms.props" />
    <None Include="..\msix\Assets\lumina-tray.ico" Pack="true" PackagePath="buildTransitive\Lumina.Forms.default.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\msix\Assets\lumina-tray.ico" LogicalName="Lumina.Forms.Assets.DefaultAppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

  <Target Name="PackLuminaFormsAnalyzer" DependsOnTargets="ResolveReferences">
    <PropertyGroup>
      <!-- The analyzer is shared by all target frameworks and needs only one package entry. -->
      <_AnalyzerPackageTargetFramework Condition="'$(TargetFrameworks)' != ''">$([System.String]::Copy('$(TargetFrameworks)').Split(';')[0])</_AnalyzerPackageTargetFramework>
      <_AnalyzerPackageTargetFramework Condition="'$(TargetFrameworks)' == ''">$(TargetFramework)</_AnalyzerPackageTargetFramework>
    </PropertyGroup>
    <ItemGroup Condition="'$(TargetFramework)' == '$(_AnalyzerPackageTargetFramework)'">
      <_LuminaFormsAnalyzerPackageFile Include="@(Analyzer)" Condition="'%(Analyzer.Filename)' == 'Lumina.Forms.Analyzers'" />
      <TfmSpecificPackageFile Include="@(_LuminaFormsAnalyzerPackageFile)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
    <Error Condition="'$(TargetFramework)' == '$(_AnalyzerPackageTargetFramework)' and '@(_LuminaFormsAnalyzerPackageFile)' == ''"
           Text="The Lumina.Forms analyzer must be resolved before packing Lumina.Forms." />
  </Target>

</Project>
