<Project>
  <!-- Keep the checked-in Designer files and resx files as the WinForms/design-time source.
       Only the LuminaForms target compiles these generated resource and source copies. -->
  <UsingTask TaskName="LuminaConvertBitmapResources" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Resources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <DesignerSources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputDirectory ParameterType="System.String" Required="true" />
      <ConvertedResources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
      <ConvertedSources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.Globalization" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Xml" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        const string typeSuffix = ".__LuminaResourceType";
        var conversionBudget = System.Diagnostics.Stopwatch.StartNew();
        if (Resources.Length > 128 || DesignerSources.Length > 128)
        {
            throw new InvalidDataException("A Drawing resource conversion is limited to 128 resource files and 128 designer files.");
        }
        var convertedResources = new List<Microsoft.Build.Framework.ITaskItem>();
        var convertedSources = new List<Microsoft.Build.Framework.ITaskItem>();
        var primitiveTypes = new HashSet<string>(StringComparer.Ordinal)
        {
            "System.String", "System.Byte[]", "System.Boolean", "System.Char",
            "System.Byte", "System.SByte", "System.Int16", "System.UInt16",
            "System.Int32", "System.UInt32", "System.Int64", "System.UInt64",
            "System.Single", "System.Double", "System.Decimal", "System.DateTime",
            "System.TimeSpan"
        };
        string resourceOutput = Path.GetFullPath(Path.Combine(OutputDirectory, "resources"));
        string sourceOutput = Path.GetFullPath(Path.Combine(OutputDirectory, "sources"));
        Directory.CreateDirectory(resourceOutput);
        Directory.CreateDirectory(sourceOutput);
        int bitmapCount = 0;
        int iconCount = 0;
        int fontCount = 0;
        foreach (var item in Resources)
        {
            if (conversionBudget.Elapsed > TimeSpan.FromSeconds(30)) throw new TimeoutException("Drawing resource conversion exceeded 30 seconds.");
            string sourcePath = Path.GetFullPath(item.ItemSpec);
            if (!string.Equals(Path.GetExtension(sourcePath), ".resx", StringComparison.OrdinalIgnoreCase))
            {
                throw new InvalidDataException("The Drawing resource input must be a resx file: " + sourcePath);
            }
            string manifestName = item.GetMetadata("ManifestResourceName");
            if (string.IsNullOrEmpty(manifestName))
            {
                throw new InvalidDataException("An explicit ManifestResourceName is required for " + sourcePath);
            }
            var document = new XmlDocument();
            document.PreserveWhitespace = true;
            document.XmlResolver = null;
            document.Load(sourcePath);
            var dataNodes = document.SelectNodes("/root/data");
            if (dataNodes.Count > 4096) throw new InvalidDataException("A converted resx file is limited to 4096 resources: " + sourcePath);
            var markers = new List<XmlElement>();
            int resourceBitmapCount = 0;
            int resourceIconCount = 0;
            int resourceFontCount = 0;
            foreach (XmlElement data in dataNodes)
            {
                if (conversionBudget.Elapsed > TimeSpan.FromSeconds(30)) throw new TimeoutException("Drawing resource conversion exceeded 30 seconds.");
                string name = data.GetAttribute("name");
                if (name.EndsWith(typeSuffix, StringComparison.Ordinal))
                {
                    throw new InvalidDataException("The generated resource type suffix is reserved: " + name);
                }
                string type = data.GetAttribute("type").Split(',')[0].Trim();
                string mimeType = data.GetAttribute("mimetype");
                XmlElement value = data["value"];
                if (value == null)
                {
                    throw new InvalidDataException("The resource has no value: " + name);
                }
                byte[] bytes = null;
                string resourceType = type;
                if (type == "System.Resources.ResXFileRef")
                {
                    string[] fileReference = value.InnerText.Split(';');
                    if (fileReference.Length != 2)
                    {
                        throw new InvalidDataException("A Drawing file reference must contain its path and type: " + name);
                    }
                    resourceType = fileReference[1].Split(',')[0].Trim();
                    if (resourceType != "System.Drawing.Bitmap" && resourceType != "System.Drawing.Icon")
                    {
                        throw new InvalidDataException("Only Bitmap and Icon file references are supported by this resource path: " + name);
                    }
                    string filePath = Path.GetFullPath(Path.Combine(Path.GetDirectoryName(sourcePath), fileReference[0]));
                    bytes = File.ReadAllBytes(filePath);
                }
                else if (type == "System.Drawing.Bitmap" || type == "System.Drawing.Icon")
                {
                    if (mimeType != "application/x-microsoft.net.object.bytearray.base64")
                    {
                        throw new InvalidDataException("Only byte-array serialized Bitmap and Icon resources are supported: " + name);
                    }
                    bytes = Convert.FromBase64String(value.InnerText);
                }
                else if (type == "System.Drawing.Font" && string.IsNullOrEmpty(mimeType))
                {
                    bytes = EncodeInvariantFont(value.InnerText);
                }
                else if ((!string.IsNullOrEmpty(type) && !primitiveTypes.Contains(type)) || !string.IsNullOrEmpty(mimeType))
                {
                    throw new InvalidDataException("Unsupported resource type or serialization: " + name + " (" + type + ", " + mimeType + ")");
                }
                if (bytes != null)
                {
                    // MSBuild's resx reader recognizes this historical resx type identity as
                    // its built-in byte[] case; a CoreLib name is treated as a custom converter.
                    data.SetAttribute("type", "System.Byte[], mscorlib");
                    data.RemoveAttribute("mimetype");
                    value.InnerText = Convert.ToBase64String(bytes);
                    XmlElement marker = document.CreateElement("data");
                    marker.SetAttribute("name", name + typeSuffix);
                    XmlElement markerValue = document.CreateElement("value");
                    markerValue.InnerText = resourceType;
                    marker.AppendChild(markerValue);
                    markers.Add(marker);
                    switch (resourceType)
                    {
                        case "System.Drawing.Bitmap": bitmapCount++; resourceBitmapCount++; break;
                        case "System.Drawing.Icon": iconCount++; resourceIconCount++; break;
                        case "System.Drawing.Font": fontCount++; resourceFontCount++; break;
                    }
                }
            }
            ValidateCount(item, "BitmapCount", resourceBitmapCount, sourcePath);
            ValidateCount(item, "IconCount", resourceIconCount, sourcePath);
            ValidateCount(item, "FontCount", resourceFontCount, sourcePath);
            foreach (XmlElement marker in markers)
            {
                document.DocumentElement.AppendChild(marker);
            }
            string destination = Path.Combine(resourceOutput, manifestName + ".resx");
            var settings = new XmlWriterSettings { Encoding = new UTF8Encoding(false), Indent = false };
            using (XmlWriter writer = XmlWriter.Create(destination, settings))
            {
                document.Save(writer);
            }
            var converted = new Microsoft.Build.Utilities.TaskItem(item);
            converted.ItemSpec = destination;
            // Prevent convention-based discovery from changing the manifest name after relocation.
            converted.SetMetadata("LogicalName", manifestName + ".resources");
            converted.SetMetadata("DependentUpon", "");
            convertedResources.Add(converted);
        }
        if (bitmapCount + iconCount + fontCount == 0)
        {
            throw new InvalidDataException("No supported Drawing resources were found in the configured resource inputs.");
        }
        foreach (var item in DesignerSources)
        {
            if (conversionBudget.Elapsed > TimeSpan.FromSeconds(30)) throw new TimeoutException("Drawing resource conversion exceeded 30 seconds.");
            string sourcePath = Path.GetFullPath(item.ItemSpec);
            string source = File.ReadAllText(sourcePath, Encoding.UTF8);
            string[] names = { "System.ComponentModel.ComponentResourceManager", "System.Resources.ResourceManager" };
            string[] replacements = { "Lumina.Forms.Resources.ComponentResourceManager", "Lumina.Forms.Resources.ResourceManager" };
            string[] counts = { "ComponentResourceManagerCount", "ResourceManagerCount" };
            for (int i = 0; i != names.Length; i++)
            {
                int expected = int.Parse(item.GetMetadata(counts[i]), System.Globalization.CultureInfo.InvariantCulture);
                int count = 0;
                for (int start = 0; (start = source.IndexOf(names[i], start, StringComparison.Ordinal)) >= 0; start += names[i].Length)
                {
                    count++;
                }
                if (count != expected)
                {
                    throw new InvalidDataException("Designer resource manager count changed in " + sourcePath + ": " + names[i] + " expected " + expected + ", found " + count);
                }
                source = source.Replace(names[i], replacements[i]);
            }
            string destination = Path.Combine(sourceOutput, convertedSources.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) + "." + Path.GetFileName(sourcePath));
            File.WriteAllText(destination, source, new UTF8Encoding(false));
            var converted = new Microsoft.Build.Utilities.TaskItem(item);
            converted.ItemSpec = destination;
            convertedSources.Add(converted);
        }
        ConvertedResources = convertedResources.ToArray();
        ConvertedSources = convertedSources.ToArray();
        Log.LogMessage(Microsoft.Build.Framework.MessageImportance.Low, "Converted {0} Bitmap, {1} Icon and {2} Font resources without runtime TypeConverter; original Designer/resx files were preserved.", bitmapCount, iconCount, fontCount);

        static void ValidateCount(Microsoft.Build.Framework.ITaskItem item, string metadata, int actual, string sourcePath)
        {
            string configured = item.GetMetadata(metadata);
            int expected = string.IsNullOrEmpty(configured) ? 0 : int.Parse(configured, CultureInfo.InvariantCulture);
            if (actual != expected)
            {
                throw new InvalidDataException(metadata + " changed in " + sourcePath + ": expected " + expected + ", found " + actual);
            }
        }

        static byte[] EncodeInvariantFont(string value)
        {
            // Match the string form written by FontConverter using InvariantCulture:
            // name[, size[unit][, style=style1[, style2...]]]. That format has no
            // escaping for commas in a family name and carries no charset/vertical
            // fields; do not guess an extended grammar or use the build machine's
            // installed fonts to resolve a family name.
            string text = value.Trim();
            if (text.Length == 0 || text.Length > 16384)
            {
                throw new InvalidDataException("A Font resource must have a nonempty invariant FontConverter string of at most 16384 characters.");
            }
            string familyName = text;
            float size = 8.25f;
            int style = 0;
            int unit = 3; // GraphicsUnit.Point
            int separator = text.IndexOf(',');
            if (separator >= 0)
            {
                familyName = text.Substring(0, separator);
                if (separator < text.Length - 1)
                {
                    int styleIndex = CultureInfo.InvariantCulture.CompareInfo.IndexOf(text, "style=", CompareOptions.IgnoreCase);
                    if (styleIndex >= 0 && styleIndex <= separator)
                    {
                        throw new InvalidDataException("The Font resource has an invalid style section: " + value);
                    }
                    string sizeText = (styleIndex >= 0
                        ? text.Substring(separator + 1, styleIndex - separator - 1)
                        : text.Substring(separator + 1)).Trim();
                    int split = 0;
                    for (; split < sizeText.Length && !char.IsLetter(sizeText[split]); split++) { }
                    char[] trim = { ',', ' ' };
                    if (split > 0)
                    {
                        string number = sizeText.Substring(0, split).Trim(trim);
                        if (!float.TryParse(number, NumberStyles.Float, CultureInfo.InvariantCulture, out size))
                        {
                            throw new InvalidDataException("The Font resource size is not invariant: " + value);
                        }
                    }
                    if (split < sizeText.Length)
                    {
                        string units = sizeText.Substring(split).TrimEnd(trim);
                        switch (units)
                        {
                            case "world": unit = 0; break;
                            case "display": unit = 1; break;
                            case "px": unit = 2; break;
                            case "pt": unit = 3; break;
                            case "in": unit = 4; break;
                            case "doc": unit = 5; break;
                            case "mm": unit = 6; break;
                            default: throw new InvalidDataException("The Font resource unit is unsupported: " + value);
                        }
                    }
                    if (styleIndex >= 0)
                    {
                        string[] styles = text.Substring(styleIndex + 6).Split(',');
                        if (styles.Length > 16)
                        {
                            throw new InvalidDataException("The Font resource has too many style tokens: " + value);
                        }
                        foreach (string token in styles)
                        {
                            string flag = token.Trim();
                            int parsed;
                            if (string.Equals(flag, "Regular", StringComparison.OrdinalIgnoreCase)) parsed = 0;
                            else if (string.Equals(flag, "Bold", StringComparison.OrdinalIgnoreCase)) parsed = 1;
                            else if (string.Equals(flag, "Italic", StringComparison.OrdinalIgnoreCase)) parsed = 2;
                            else if (string.Equals(flag, "Underline", StringComparison.OrdinalIgnoreCase)) parsed = 4;
                            else if (string.Equals(flag, "Strikeout", StringComparison.OrdinalIgnoreCase)) parsed = 8;
                            else if (!int.TryParse(flag, NumberStyles.Integer, CultureInfo.InvariantCulture, out parsed))
                            {
                                throw new InvalidDataException("The Font resource style is unsupported: " + value);
                            }
                            if ((parsed & ~15) != 0)
                            {
                                throw new InvalidDataException("The Font resource style has invalid flags: " + value);
                            }
                            style |= parsed;
                        }
                    }
                }
            }
            if (!(size > 0) || float.IsInfinity(size))
            {
                throw new InvalidDataException("The Font resource size must be finite and positive: " + value);
            }

            using (var output = new MemoryStream())
            {
                using (var writer = new BinaryWriter(output, new UTF8Encoding(false, true), true))
                {
                    writer.Write(0x3152464C); // LFR1; consumed directly by the runtime resource decoder.
                    writer.Write(familyName);
                    writer.Write(size);
                    writer.Write(style);
                    writer.Write(unit);
                    writer.Write((byte)1); // FontConverter's default GDI charset.
                    writer.Write(false);  // FontConverter's default vertical flag; @ names remain intact.
                }
                return output.ToArray();
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="PrepareLuminaBitmapResources" BeforeTargets="AssignTargetPaths"
          Condition="'$(TargetFramework)' == 'net10.0' and '$(UseLuminaForms)' == 'true'">
    <ItemGroup>
      <_UnconfiguredLuminaBitmapResource Include="@(EmbeddedResource)" Exclude="@(LuminaBitmapResource)"
                                        Condition="'%(EmbeddedResource.Extension)' == '.resx'" />
    </ItemGroup>
    <Error Condition="'@(_UnconfiguredLuminaBitmapResource)' != ''"
           Text="Configure an explicit resource conversion scope before adding resx files to the LuminaForms target: @(_UnconfiguredLuminaBitmapResource)" />
    <LuminaConvertBitmapResources Resources="@(LuminaBitmapResource)" DesignerSources="@(LuminaBitmapResourceDesigner)"
                                  OutputDirectory="$(IntermediateOutputPath)LuminaBitmapResources">
      <Output TaskParameter="ConvertedResources" ItemName="_LuminaConvertedBitmapResources" />
      <Output TaskParameter="ConvertedSources" ItemName="_LuminaConvertedBitmapSources" />
    </LuminaConvertBitmapResources>
    <ItemGroup>
      <EmbeddedResource Remove="@(LuminaBitmapResource)" />
      <EmbeddedResource Include="@(_LuminaConvertedBitmapResources)" />
      <Compile Remove="@(LuminaBitmapResourceDesigner)" />
      <Compile Include="@(_LuminaConvertedBitmapSources)" />
      <FileWrites Include="@(_LuminaConvertedBitmapResources);@(_LuminaConvertedBitmapSources)" />
    </ItemGroup>
  </Target>
</Project>
